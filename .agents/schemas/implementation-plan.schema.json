{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-harness://agents/implementation-plan.schema.json",
  "title": "Agentic Harness Technical Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "acceptanceCriteria",
    "workItems"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "statement",
          "blocking",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "proofStage": {
            "enum": [
              "implementation",
              "quality-assurance",
              "database-readiness",
              "infrastructure-readiness",
              "ai-readiness",
              "product-acceptance"
            ]
          }
        }
      }
    },
    "workItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ownerAgentId",
          "objective",
          "dependencies",
          "ownedPaths",
          "acceptanceCriteria",
          "validation",
          "complexity",
          "estimatedFiles",
          "contractChange",
          "migration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ownerAgentId": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownedPaths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "complexity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "estimatedFiles": {
            "type": "integer",
            "minimum": 1
          },
          "contractChange": {
            "type": "boolean"
          },
          "migration": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validationExecutionScope": {
            "enum": [
              "workspace",
              "container",
              "authoritative-host",
              "live"
            ],
            "description": "Execution namespace required by every validation command in this work item. Implementation work must remain workspace scoped; host/live proofs belong to downstream readiness/live gates."
          },
          "executionMode": {
            "enum": [
              "agent",
              "deterministic-reuse"
            ],
            "description": "Runtime execution strategy. deterministic-reuse is valid only for byte-identical existing implementation output with executable criterion validation and no contract or migration changes."
          }
        }
      }
    }
  }
}
