{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-harness://agents/task-brief.schema.json",
  "title": "Agentic Harness Task Brief v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "agentId",
    "objective",
    "acceptanceCriteria",
    "upstreamAcceptanceCriteria",
    "invariants",
    "ownedPaths",
    "readOnlyContextPaths",
    "sharedPathOwner",
    "inputs",
    "dependencies",
    "outOfScope",
    "expectedEvidence",
    "validation",
    "contextPacketId",
    "attemptBudget",
    "deadlineOrBudget",
    "sdd",
    "modelRouting"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "statement",
          "blocking",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "proofStage": {
            "enum": [
              "implementation",
              "quality-assurance",
              "database-readiness",
              "infrastructure-readiness",
              "ai-readiness",
              "product-acceptance"
            ]
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ownedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readOnlyContextPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sharedPathOwner": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextPacketId": {
      "type": "string",
      "minLength": 1
    },
    "attemptBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "deadlineOrBudget": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": true
    },
    "modelRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "variant",
        "reasoningEffort",
        "stepsLimit",
        "rationale",
        "costClass",
        "attempt",
        "role"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoningEffort": {
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ]
        },
        "stepsLimit": {
          "type": "integer",
          "minimum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "costClass": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "modelClass": {
          "type": "string",
          "minLength": 1
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "latencySloMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "routingPolicy": {
          "enum": [
            "champion",
            "challenger-benchmark"
          ]
        }
      }
    },
    "executionTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestrationRole",
        "interactiveMode",
        "sessionRole"
      ],
      "properties": {
        "orchestrationRole": {
          "enum": [
            "orchestrator",
            "specialist"
          ]
        },
        "interactiveMode": {
          "enum": [
            "primary",
            "subagent"
          ]
        },
        "sessionRole": {
          "const": "primary"
        }
      },
      "description": "Separates the global orchestration topology from the interactive OpenCode adapter and the isolated Runtime V2 session role. Specialists remain subagents globally but execute as the primary agent of their assigned headless task session."
    },
    "sdd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "stage",
        "workItemId",
        "workflowSkill",
        "requiredSuperpowers"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "workItemId": {
          "type": "string",
          "minLength": 1
        },
        "workflowSkill": {
          "const": "agent-harness-sdd-workflow"
        },
        "requiredSuperpowers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewedRevision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "upstreamAcceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "statement",
          "blocking",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "proofStage": {
            "enum": [
              "implementation",
              "quality-assurance",
              "database-readiness",
              "infrastructure-readiness",
              "ai-readiness",
              "product-acceptance"
            ]
          }
        }
      },
      "description": "Immutable Product Owner acceptance criteria promoted into Technical Refinement so implementationPlan can copy them exactly. The array is empty before Product Discovery has produced criteria; Technical Refinement enforces at least one criterion in the runtime."
    },
    "changeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "scope",
        "preexistingWorkingTreeIsNotAttributed",
        "entries",
        "implementationChangedPaths",
        "implementationReusedPaths"
      ],
      "properties": {
        "authority": {
          "const": "runtime-accepted-dependency-handoffs"
        },
        "scope": {
          "const": "direct-dependencies"
        },
        "preexistingWorkingTreeIsNotAttributed": {
          "const": true
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "agentId",
              "role",
              "stage",
              "artifactId",
              "artifactVersion",
              "changedPaths",
              "reusedPaths",
              "usedContextPaths"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "agentId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stage": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "artifactId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "artifactVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "changedPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reusedPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "usedContextPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "implementationChangedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementationReusedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Runtime-owned attribution of accepted direct-dependency changes. Pre-existing repository state is never attributed to a dependency merely because it is visible in git status."
    },
    "validationExecutionScope": {
      "enum": [
        "workspace",
        "container",
        "authoritative-host",
        "live"
      ]
    },
    "executionMode": {
      "enum": [
        "agent",
        "deterministic-reuse"
      ]
    }
  }
}
