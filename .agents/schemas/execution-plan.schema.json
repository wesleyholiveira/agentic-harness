{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-harness://agents/execution-plan.schema.json",
  "title": "Agentic Harness Dynamic Multi-Agent Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "request",
    "createdAt",
    "phase",
    "routing",
    "sharedPathOwner",
    "workflow",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "enum": [
        "bootstrap",
        "compiled"
      ]
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sharedPathOwner": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresDatabase",
        "requiresDevOps",
        "requiresAiLlmOps",
        "productOwnerTaskId",
        "technicalLeadTaskId",
        "qualityAgentId"
      ],
      "properties": {
        "requiresDevOps": {
          "type": "boolean"
        },
        "requiresAiLlmOps": {
          "type": "boolean"
        },
        "productOwnerTaskId": {
          "type": "string"
        },
        "technicalLeadTaskId": {
          "type": "string"
        },
        "qualityAgentId": {
          "type": "string"
        },
        "implementationPlanRevision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "compiledAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "requiresDatabase": {
          "type": "boolean"
        },
        "bootstrapReviewTopology": {
          "enum": [
            "decision-dependent-v1",
            "fact-capability-v2"
          ]
        },
        "bootstrapReviewDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromStage",
              "toStage",
              "fromTaskId",
              "toTaskId",
              "requiredDecision",
              "rationale",
              "provenance"
            ],
            "properties": {
              "fromStage": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-review$"
              },
              "toStage": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-review$"
              },
              "fromTaskId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "toTaskId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requiredDecision": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "factId": {
                "type": "string",
                "minLength": 1
              },
              "fromCapabilityId": {
                "type": "string",
                "minLength": 1
              },
              "toCapabilityId": {
                "type": "string",
                "minLength": 1
              },
              "legacyRequiredDecision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "bootstrapFactBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factId",
              "status",
              "resolution",
              "consumerCapabilityId",
              "consumerStage",
              "consumerTaskId",
              "providerCapabilityId",
              "providerStage",
              "providerTaskId",
              "source",
              "evidence",
              "rationale",
              "provenance"
            ],
            "properties": {
              "factId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "resolved",
                  "unresolved-review-input"
                ]
              },
              "resolution": {
                "enum": [
                  "authoritative-context",
                  "review"
                ]
              },
              "consumerCapabilityId": {
                "type": "string",
                "minLength": 1
              },
              "consumerStage": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-review$"
              },
              "consumerTaskId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "providerCapabilityId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "providerStage": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-review$"
              },
              "providerTaskId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "bootstrapTopologyState": {
          "enum": [
            "provisional",
            "refined"
          ]
        },
        "bootstrapTopologyRevision": {
          "type": "integer",
          "minimum": 1
        },
        "bootstrapTopologyAuthority": {
          "type": "string",
          "minLength": 1
        },
        "bootstrapFactTopology": {
          "enum": [
            "fact-capability-v2"
          ]
        },
        "bootstrapCandidateReviewStages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-review$"
          },
          "uniqueItems": true
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "agentId",
          "objective",
          "dependencies",
          "ownedPaths",
          "role",
          "sddRole",
          "stage",
          "workItemId",
          "reasoningLevel",
          "acceptanceCriteria",
          "validation"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "enum": [
              "contract",
              "implementation",
              "platform",
              "verification"
            ]
          },
          "reasoningLevel": {
            "enum": [
              "low",
              "medium",
              "high",
              "max"
            ]
          },
          "sddRole": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "pattern": "^(?:product-discovery|technical-refinement|implementation|quality-assurance|operational-readiness|product-acceptance|[a-z0-9]+(?:-[a-z0-9]+)*-review)$"
          },
          "workItemId": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "complexity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "estimatedFiles": {
            "type": "integer",
            "minimum": 0
          },
          "contractChange": {
            "type": "boolean"
          },
          "migration": {
            "type": "boolean"
          },
          "executionRequirements": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capabilityId",
              "reasoningClass",
              "interactionMode",
              "modelBinding",
              "modelClass",
              "capabilities",
              "binding"
            ],
            "properties": {
              "capabilityId": {
                "type": "string",
                "minLength": 1
              },
              "reasoningClass": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "max"
                ]
              },
              "interactionMode": {
                "enum": [
                  "subagent",
                  "primary",
                  "non-interactive"
                ]
              },
              "modelBinding": {
                "const": "runtime-route"
              },
              "modelClass": {
                "type": "string",
                "minLength": 1
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "binding": {
                "const": "runtime-route"
              }
            }
          },
          "validationExecutionScope": {
            "enum": [
              "workspace",
              "container",
              "authoritative-host",
              "live"
            ]
          },
          "executionMode": {
            "enum": [
              "agent",
              "deterministic-reuse"
            ]
          }
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "plannerVersion",
        "compilerVersion",
        "requestFingerprint",
        "registryFingerprint",
        "capabilityCatalogFingerprint",
        "reasoningFingerprint",
        "schemaFingerprint",
        "policyFingerprint"
      ],
      "properties": {
        "contractVersion": {
          "const": "agent-runtime-provenance/v1"
        },
        "plannerVersion": {
          "type": "string",
          "minLength": 1
        },
        "compilerVersion": {
          "type": "string",
          "minLength": 1
        },
        "requestFingerprint": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "registryFingerprint": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "capabilityCatalogFingerprint": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "reasoningFingerprint": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "policyFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "schemaFingerprint": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "initialPlanFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:"
        },
        "productDiscoveryAssessmentFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:"
        },
        "bootstrapTopologyFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "fingerprint",
        "planDecision"
      ],
      "properties": {
        "contractVersion": {
          "const": "runtime-policy/v1"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "planDecision": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
