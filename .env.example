# Agentic Harness — project-agnostic local runtime defaults.
# Copy to .env in the harness checkout/submodule only when overriding defaults.

POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_harness
AGENT_HARNESS_POSTGRES_PORT=5432
AGENT_POSTGRES_URL=postgresql://agent:agent@127.0.0.1:5432/agent_harness
AGENT_POSTGRES_SCHEMA=public

RABBITMQ_DEFAULT_USER=agent
RABBITMQ_DEFAULT_PASS=agent
AGENT_HARNESS_RABBITMQ_PORT=5672
AGENT_HARNESS_RABBITMQ_MANAGEMENT_PORT=15672
AGENT_HARNESS_RUNTIME_RABBITMQ_URL=amqp://agent:agent@127.0.0.1:5672/%2f
AGENT_HARNESS_RUNTIME_WORKER_ID=agentic-harness-worker
AGENT_HARNESS_RUNTIME_WORKER_CONCURRENCY=3
# Rust tracing filter for agent-runtime-worker. INFO is the safe operational default.
AGENT_HARNESS_RUNTIME_LOG_FILTER=info
AGENT_RUNTIME_WORKER_REQUIRED=true
OUTBOX_POLL_INTERVAL_MS=100
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_PUBLISH_ATTEMPTS=5

AGENT_HARNESS_REDIS_PORT=6379
AGENT_HARNESS_EMBEDDINGS_PORT=8791
AGENT_HARNESS_CONTEXT_ENGINE_PORT=8789
AGENT_HARNESS_CONTEXT_ENGINE_MCP_URL=http://127.0.0.1:8789/mcp
CONTEXT_ENGINE_HTTP_PORT=8789
CONTEXT_ENGINE_PROJECT_MEMORY_BACKEND=postgres
CONTEXT_ENGINE_PROJECT_MEMORY_POSTGRES_URL=postgresql://agent:agent@postgres:5432/agent_harness
CONTEXT_ENGINE_PROJECT_MEMORY_MIGRATION_REQUIRED=true
CONTEXT_ENGINE_EXACT_CACHE_BACKEND=redis
CONTEXT_ENGINE_EXACT_CACHE_NAMESPACE=agent:harness:context:exact:v1
CONTEXT_EXACT_REDIS_URL=redis://redis:6379
CONTEXT_SEMANTIC_CACHE_MODE=enforce
CONTEXT_SEMANTIC_CACHE_FAILURE_MODE=open
CONTEXT_SEMANTIC_REDIS_URL=redis://redis:6379
CONTEXT_SEMANTIC_REDIS_INDEX_PREFIX=agent:harness:context:semantic
CONTEXT_SEMANTIC_EMBEDDING_PROVIDER=tei
CONTEXT_SEMANTIC_EMBEDDING_BASE_URL=http://context-embeddings:80
CONTEXT_SEMANTIC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CONTEXT_SEMANTIC_EMBEDDING_DIMENSIONS=384
CONTEXT_ENGINE_CBM_TRANSPORT=persistent-mcp
CONTEXT_ENGINE_CBM_AUTO_INDEX=true
CONTEXT_ENGINE_CBM_BOOTSTRAP_MODE=full

# OpenCode host/TUI used by durable continuation.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
AGENT_HARNESS_OPENCODE_CONTINUATION_URL=http://host.docker.internal:4096
AGENT_HARNESS_OPENCODE_CONTINUATION_HOST_PROBE_URL=http://127.0.0.1:4096
AGENT_HARNESS_OPENCODE_CONTINUATION_USERNAME=opencode
AGENT_HARNESS_OPENCODE_CONTINUATION_PASSWORD=
# Optional absolute host path to ~/.local/share/opencode/auth.json for the Rust worker container.
AGENT_HARNESS_OPENCODE_AUTH_HOST_FILE=

# OpenCode/MCP integrations.
AGENT_HARNESS_DEFAULT_MODEL=openai/gpt-5.6-luna
CONTEXT7_API_KEY=
CODEBASE_MEMORY_MCP_COMMAND=codebase-memory-mcp
HEADROOM_PROXY_PORT=8793
HEADROOM_SAVINGS_PROFILE=balanced
HEADROOM_TARGET_RATIO=0.20
HEADROOM_MIN_TOKENS=250
HEADROOM_TELEMETRY=off
# Set false to launch OpenCode without the Headroom wrapper.
AGENT_HARNESS_HEADROOM_ENABLED=true
